{
  "name": "review-quote-sh",
  "version": "1.1.0",
  "private": true,
  "description": "Message review (multi-model cross review) + quote (Q&A chips) for the DSH conversation UI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots", "timer"]
    }
  },
  "dependencies": {
    "react": "^18.2.0"
  }
}
